# Database (Postgres+pgvector in docker-compose; SQLite is the local/dev default in code)
DB_URL=postgresql+psycopg2://claimsight:claimsight@localhost:5432/claimsight

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# File storage (shared between API and worker)
STORAGE_DIR=./storage

# Document Agent
DOC_QA_MODEL=impira/layoutlm-document-qa
DOC_QA_MIN_CONFIDENCE=0.5

# RAG / embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5

# Vision Agent (zero-shot; see DECISIONS.md D14)
VISION_DETECTION_MODEL=google/owlvit-base-patch32
VISION_CLASSIFICATION_MODEL=openai/clip-vit-base-patch32
VISION_VQA_MODEL=Salesforce/blip-vqa-base
VISION_DETECTION_THRESHOLD=0.45
VISION_LOW_CONFIDENCE_THRESHOLD=0.4

# Fraud/Risk + External Verifiers (Slice 4)
FRAUD_ZERO_SHOT_MODEL=typeform/distilbert-base-uncased-mnli
HTTP_USER_AGENT=ClaimSight/0.1 (portfolio claims triage; contact: claimsight-dev@example.com)
EXTERNAL_API_TIMEOUT_SECONDS=5
EXTERNAL_API_MAX_ATTEMPTS=2
NHTSA_CACHE_TTL_HOURS=24
WEATHER_STORM_PRECIP_MM=5.0

# Adjudicator (Slice 5) — OpenAI Chat Completions via httpx; never commit real keys
# OPENAI_API_KEY=
ADJUDICATOR_MODEL=gpt-4o
ADJUDICATOR_BASE_URL=https://api.openai.com/v1
ADJUDICATOR_TIMEOUT_SECONDS=60

# Langfuse observability (Slice 8) — optional; leave unset for no-op tracing / CI
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Upload limits
MAX_UPLOAD_MB=10

# Celery (set true only for local pytest — do not use in docker-compose)
CELERY_TASK_ALWAYS_EAGER=false
